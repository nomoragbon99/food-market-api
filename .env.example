# PostgreSQL connection string used by Prisma.
# Copy this file to .env and fill in real values locally; never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/food_market?schema=public"

# Absolute, public base URL of the deployed API, read by the browser page at
# /consumer. Must be absolute (never a relative path, never localhost) because
# the page calls the API cross-origin, exactly as any other client would.
# Railway provides the deployed origin, e.g. https://your-service.up.railway.app
NEXT_PUBLIC_API_BASE_URL="https://your-service.up.railway.app"
